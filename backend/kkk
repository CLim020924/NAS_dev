/********************************************************************
 * index.js - Socket.io + 영구 저장 + 마스터 계정 구분 + 실시간 알림
 ********************************************************************/
const express = require('express');
const cors = require('cors');
const cookieParser = require('cookie-parser');
const fs = require('fs');
const path = require('path');
const http = require('http');             // Socket.io 사용을 위해 http 모듈 필요
const { Server } = require('socket.io');  // Socket.io Server

const app = express();
const PORT = 3030;

/******************************************************
 * 미들웨어 설정
 ******************************************************/
app.use(express.json());
app.use(cors({
  origin: '*',
  credentials: true
}));
app.use(cookieParser());

/******************************************************
 * 회원 정보 영구 저장 파일 경로
 ******************************************************/
const membersFilePath = path.join(__dirname, 'data', 'members.json');

/******************************************************
 * 임시 회원가입 요청 배열
 ******************************************************/
let signupRequests = [];

/******************************************************
 * approvedUsers는 서버 시작 시 loadMembers()로 초기화
 ******************************************************/
let approvedUsers = [];

/******************************************************
 * 추가 마스터 계정 목록 (최초 마스터(dntdlzz)가 생성한 추가 마스터 계정의 id를 저장)
 ******************************************************/
let additionalMasters = [];

/******************************************************
 * 파일에서 회원 정보 로드 (loadMembers)
 ******************************************************/
function loadMembers() {
  try {
    const data = fs.readFileSync(membersFilePath, 'utf8');
    approvedUsers = JSON.parse(data);
    if (!Array.isArray(approvedUsers)) {
      throw new Error('members.json이 배열 형식이 아닙니다.');
    }
    console.log(`회원 정보 로드 성공: ${approvedUsers.length}명`);
    // 추가 마스터 계정 배열 초기화 (저장된 회원 중 isAdditionalMaster true인 것 수집)
    additionalMasters = approvedUsers.filter(u => u.isAdditionalMaster).map(u => u.id);
  } catch (err) {
    console.error('회원 정보 로드 실패:', err);
    // 파일이 없거나 형식 오류 시 최초 마스터 계정만 세팅
    approvedUsers = [
      { id: 'dntdlzz', password: '001004asAS@', isMaster: true, disabled: false, isOnline: false }
    ];
    saveMembers();
  }
}

/******************************************************
 * 파일에 회원 정보 저장 (saveMembers)
 ******************************************************/
function saveMembers() {
  try {
    fs.writeFileSync(membersFilePath, JSON.stringify(approvedUsers, null, 2), 'utf8');
    console.log('회원 정보 저장 성공');
  } catch (err) {
    console.error('회원 정보 저장 실패:', err);
  }
}

/******************************************************
 * 서버 시작 시 회원 정보 로드
 ******************************************************/
loadMembers();

/******************************************************
 * NAS 경로 설정
 ******************************************************/
const nasPath = '/mnt/nas';

/******************************************************
 * NAS 파일/폴더 API
 ******************************************************/
app.get('/api/files', (req, res) => {
  fs.readdir(nasPath, (err, items) => {
    if (err) {
      console.error('NAS 파일 읽기 실패:', err);
      return res.status(500).json({ error: '파일 읽기 에러' });
    }
    const data = items.map(item => {
      const fullPath = path.join(nasPath, item);
      let stat;
      try {
        stat = fs.statSync(fullPath);
      } catch (e) {
        return null;
      }
      return {
        name: item,
        type: stat.isDirectory() ? 'folder' : 'file',
        fullPath,
        url: stat.isDirectory() ? null : `http://${req.headers.host}/api/file?path=${encodeURIComponent(fullPath)}`
      };
    }).filter(Boolean);
    res.json(data);
  });
});

app.get('/api/file', (req, res) => {
  const filePath = req.query.path;
  if (!filePath) {
    return res.status(400).send('파일 경로 필요');
  }
  res.sendFile(filePath);
});

/******************************************************
 * 회원가입 요청 API
 ******************************************************/
app.post('/api/signup-request', (req, res) => {
  const { id, password, passwordConfirm } = req.body;
  if (!id || !password || !passwordConfirm) {
    return res.status(400).json({ error: '모든 항목을 입력해주세요.' });
  }
  if (password !== passwordConfirm) {
    return res.status(400).json({ error: '비밀번호가 일치하지 않습니다.' });
  }
  if (approvedUsers.find(u => u.id === id) || signupRequests.find(r => r.id === id)) {
    return res.status(400).json({ error: '이미 존재하는 아이디입니다.' });
  }
  signupRequests.push({ id, password });
  // 실시간 업데이트 이벤트
  io.emit('signupRequestsChanged');
  res.json({ message: '회원가입 요청이 접수되었습니다.' });
});

app.get('/api/signup-requests', (req, res) => {
  res.json(signupRequests);
});

app.post('/api/signup-requests/:id/accept', (req, res) => {
  const requestId = req.params.id;
  const index = signupRequests.findIndex(r => r.id === requestId);
  if (index === -1) {
    return res.status(404).json({ error: '요청을 찾을 수 없습니다.' });
  }
  const newUser = signupRequests[index];
  
  approvedUsers.push({
    id: newUser.id,
    password: newUser.password,
    isMaster: false,           // 추가 마스터 계정은 isMaster false, 대신 isAdditionalMaster 플래그 사용
    isAdditionalMaster: false, // 일반 회원으로 승인 시 false (추가 마스터가 아니라면)
    disabled: false,
    isOnline: false
  });
  signupRequests.splice(index, 1);
  saveMembers();
  io.emit('signupRequestsChanged');
  io.emit('membersChanged');
  res.json({ message: '회원가입 요청 승인 완료.' });
});

app.post('/api/signup-requests/:id/reject', (req, res) => {
  const requestId = req.params.id;
  const index = signupRequests.findIndex(r => r.id === requestId);
  if (index === -1) {
    return res.status(404).json({ error: '요청을 찾을 수 없습니다.' });
  }
  signupRequests.splice(index, 1);
  io.emit('signupRequestsChanged');
  res.json({ message: '회원가입 요청 거절 완료.' });
});

/******************************************************
 * 마스터 계정 생성 (최초 마스터 계정 dntdlzz만 가능)
 ******************************************************/
app.post('/api/create-master', (req, res) => {
  const { requesterId, id, password } = req.body;
  // 최초 마스터 계정만 생성 가능
  const requester = approvedUsers.find(u => u.id === requesterId && !u.disabled);
  if (!requester || requester.id !== 'dntdlzz') {
    return res.status(403).json({ error: '최초 마스터 계정(dntdlzz)만 새 마스터 계정을 생성할 수 있습니다.' });
  }
  if (!id || !password) {
    return res.status(400).json({ error: '아이디와 비밀번호를 입력해주세요.' });
  }
  if (approvedUsers.find(u => u.id === id)) {
    return res.status(400).json({ error: '이미 존재하는 아이디입니다.' });
  }
  // 새 마스터 계정 생성 시, isMaster는 false, isAdditionalMaster true로 설정
  approvedUsers.push({
    id,
    password,
    isMaster: false,
    isAdditionalMaster: true,
    disabled: false,
    isOnline: false
  });
  // 추가 마스터 배열에 추가
  additionalMasters.push(id);
  saveMembers();
  io.emit('membersChanged');
  res.json({ message: '새로운 마스터 계정이 생성되었습니다.' });
});

/******************************************************
 * 로그인 / 로그아웃
 ******************************************************/
app.post('/api/login', (req, res) => {
  const { id, password } = req.body;
  const user = approvedUsers.find(u => u.id === id && u.password === password);
  if (!user) {
    return res.status(401).json({ error: '아이디 혹은 비밀번호가 틀렸거나 계정이 존재하지 않습니다.' });
  }
  if (user.disabled) {
    return res.status(403).json({ error: '관리자에 의해 비활성화된 계정입니다.' });
  }
  user.isOnline = true;
  res.cookie('token', 'your_secure_token', {
    httpOnly: true,
    secure: false,
    sameSite: 'None'
  });
  io.emit('userStatusChanged', { id: user.id, isOnline: true });
  res.json({ message: '로그인 성공', user });
});

app.post('/api/logout', (req, res) => {
  const { id } = req.body;
  const user = approvedUsers.find(u => u.id === id);
  if (!user) {
    return res.status(404).json({ error: '사용자를 찾을 수 없습니다.' });
  }
  user.isOnline = false;
  io.emit('userStatusChanged', { id: user.id, isOnline: false });
  res.json({ message: '로그아웃 성공' });
});

/******************************************************
 * 회원 목록 조회 / 비활성화 / 활성화 / 삭제
 ******************************************************/
app.get('/api/members', (req, res) => {
  res.json(approvedUsers);
});

// 회원 비활성화
app.delete('/api/members/:id', (req, res) => {
  const { id } = req.params;
  const { requesterId } = req.body;
  const requester = approvedUsers.find(u => u.id === requesterId);
  if (!requester || !requester.isMaster) {
    return res.status(403).json({ error: '권한이 없습니다.' });
  }
  // dntdlzz 및 추가 마스터 보호
  if (id === 'dntdlzz' || additionalMasters.includes(id)) {
    return res.status(400).json({ error: '마스터 계정은 비활성화할 수 없습니다.' });
  }
  const user = approvedUsers.find(u => u.id === id);
  if (!user) {
    return res.status(404).json({ error: '회원이 존재하지 않습니다.' });
  }
  user.disabled = true;
  saveMembers();
  io.emit('membersChanged');
  res.json({ message: '회원이 비활성화되었습니다.' });
});

// 회원 활성화
app.put('/api/members/:id/enable', (req, res) => {
  const { id } = req.params;
  const { requesterId } = req.body;
  const requester = approvedUsers.find(u => u.id === requesterId);
  if (!requester || !requester.isMaster) {
    return res.status(403).json({ error: '권한이 없습니다.' });
  }
  const user = approvedUsers.find(u => u.id === id);
  if (!user) {
    return res.status(404).json({ error: '회원이 존재하지 않습니다.' });
  }
  user.disabled = false;
  saveMembers();
  io.emit('membersChanged');
  res.json({ message: '회원이 활성화되었습니다.' });
});

// 회원 영구 삭제
app.delete('/api/members/:id/permanent', (req, res) => {
  const { id } = req.params;
  const { requesterId } = req.body;
  const requester = approvedUsers.find(u => u.id === requesterId);
  if (!requester || !requester.isMaster) {
    return res.status(403).json({ error: '권한이 없습니다.' });
  }
  // dntdlzz 및 추가 마스터 보호
  if (id === 'dntdlzz' || additionalMasters.includes(id)) {
    return res.status(400).json({ error: '마스터 계정은 삭제할 수 없습니다.' });
  }
  const index = approvedUsers.findIndex(u => u.id === id);
  if (index === -1) {
    return res.status(404).json({ error: '회원이 존재하지 않습니다.' });
  }
  approvedUsers.splice(index, 1);
  saveMembers();
  io.emit('membersChanged');
  res.json({ message: '회원이 영구 삭제되었습니다.' });
});

/******************************************************
 * Socket.io 설정 및 서버 실행
 ******************************************************/
const server = http.createServer(app);
const io = new Server(server, {
  cors: {
    origin: '*',
    credentials: true
  }
});

io.on('connection', (socket) => {
  console.log('클라이언트 연결됨:', socket.id);
  socket.on('disconnect', () => {
    console.log('클라이언트 해제:', socket.id);
  });
});

server.listen(PORT, () => {
  console.log(`서버가 포트 ${PORT}에서 실행 중입니다. (with Socket.io)`);
});
