# Copy this file to .env on the NAS server and fill only the values that differ.
# Never commit .env.

# Public addresses
APP_DOMAIN=filemanager-nas.com
UPLOAD_DOMAIN=upload.filemanager-nas.com
PUBLIC_BASE_URL=https://filemanager-nas.com
UPLOAD_BASE_URL=https://upload.filemanager-nas.com
COOKIE_DOMAIN=.filemanager-nas.com

# Server ports and static frontend
BACKEND_PORT=3030
FRONTEND_BUILD_PATH=/var/www/html

# NAS storage roots
NAS_ROOT=/mnt/nas
NAS_BACKUP_DIR=backup
CHATDATA_DIR=chatdata
CHAT_TEMP_DIR=chat_tmp

# Auth/session
JWT_SECRET=change-this-to-a-long-random-secret
SESSION_DISCONNECT_LOGOUT_MS=60000
MEETING_DISCONNECT_GRACE_MS=600000

# AI
AI_PROVIDER=openai
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
