import React, { useEffect, useMemo, useState } from 'react';
import {
  Box,
  Paper,
  Typography,
  Avatar,
  Button,
  TextField,
  Divider,
  useTheme,
} from '@mui/material';
import OpenInNewIcon from '@mui/icons-material/OpenInNew';
import { useWindows } from '../contexts/WindowContext';

const DockedChatPanel = ({ sidebarWidth = 360 }) => {
  const theme = useTheme();
  const {
    openWindows,
    setOpenWindows,
    topZIndex,
    setTopZIndex,
    focusWindow,
  } = useWindows();

  const dockedChat = useMemo(() => {
    const items = openWindows.filter((w) => w.winType === 'chat' && w.chatMode !== 'window' && !w.isMinimized);
    return items.length ? items[items.length - 1] : null;
  }, [openWindows]);

  const [drafts, setDrafts] = useState({});
  const [localMessages, setLocalMessages] = useState({});

  useEffect(() => {
    if (!dockedChat) return;
    setLocalMessages((prev) => {
      if (prev[dockedChat.id]) return prev;
      return {
        ...prev,
        [dockedChat.id]: [
          {
            id: `${dockedChat.id}_welcome`,
            sender: 'system',
            text: `${dockedChat.chatDisplayName || dockedChat.name}님과의 채팅창 틀입니다. 실시간 메시지 연결은 다음 단계에서 붙일 예정입니다.`,
            createdAt: new Date().toISOString(),
          },
        ],
      };
    });
  }, [dockedChat]);

  if (!dockedChat) return null;

  const handleSend = () => {
    const value = (drafts[dockedChat.id] || '').trim();
    if (!value) return;

    setLocalMessages((prev) => ({
      ...prev,
      [dockedChat.id]: [
        ...(prev[dockedChat.id] || []),
        {
          id: `${dockedChat.id}_${Date.now()}`,
          sender: 'me',
          text: value,
          createdAt: new Date().toISOString(),
        },
      ],
    }));

    setDrafts((prev) => ({ ...prev, [dockedChat.id]: '' }));
  };

  const openAsWindow = () => {
    setOpenWindows((prev) =>
      prev.map((w) =>
        w.id === dockedChat.id
          ? {
              ...w,
              chatMode: 'window',
              width: w.width || 420,
              height: w.height || 560,
              x: typeof w.x === 'number' ? w.x : 120,
              y: typeof w.y === 'number' ? w.y : 90,
              zIndex: topZIndex + 1,
              isMinimized: false,
            }
          : w
      )
    );
    setTopZIndex((prev) => prev + 1);
    setTimeout(() => focusWindow(dockedChat.id), 0);
  };

  const messages = localMessages[dockedChat.id] || [];

  return (
    <Paper
      elevation={0}
      sx={{
        position: 'absolute',
        top: 0,
        bottom: 0,
        left: 0,
        width: typeof window !== 'undefined' && window.innerWidth < 600
          ? Math.min(360, Math.round(window.innerWidth * 0.86))
          : 390,
        transform: 'translateX(-100%)',
        borderRadius: 0,
        borderLeft: `1px solid ${theme.palette.divider}`,
        borderTop: `1px solid ${theme.palette.divider}`,
        borderBottom: `1px solid ${theme.palette.divider}`,
        bgcolor: 'background.paper',
        display: 'flex',
        flexDirection: 'column',
        overflow: 'hidden',
      }}
      onMouseDown={() => focusWindow(dockedChat.id)}
    >
      <Box
        sx={{
          px: 1.25,
          py: 1,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          bgcolor: theme.palette.mode === 'dark' ? '#111827' : '#f8fafc',
          borderBottom: `1px solid ${theme.palette.divider}`,
        }}
      >
        <Box sx={{ display: 'flex', alignItems: 'center', minWidth: 0, gap: 1 }}>
          <Button
            size="small"
            variant="outlined"
            startIcon={<OpenInNewIcon />}
            onClick={(e) => {
              e.stopPropagation();
              openAsWindow();
            }}
          >
            window
          </Button>
          <Avatar
            sx={{
              width: 28,
              height: 28,
              bgcolor:
                dockedChat.chatRole === 'MASTER'
                  ? 'error.main'
                  : dockedChat.chatRole === 'MANAGER'
                  ? 'warning.main'
                  : 'primary.main',
              fontSize: '0.85rem',
              fontWeight: 'bold',
            }}
          >
            {(dockedChat.chatDisplayName || dockedChat.name)?.[0]?.toUpperCase()}
          </Avatar>
          <Box sx={{ minWidth: 0 }}>
            <Typography variant="body2" sx={{ fontWeight: 800 }} noWrap>
              {dockedChat.chatDisplayName || dockedChat.name}
            </Typography>
            <Typography variant="caption" color="text.secondary" noWrap>
              @{dockedChat.chatUsername || dockedChat.name}
            </Typography>
          </Box>
        </Box>
      </Box>

      <Box sx={{ px: 1.5, py: 1, bgcolor: 'background.default', borderBottom: `1px solid ${theme.palette.divider}` }}>
        <Typography variant="caption" color="text.secondary">
          이 단계는 채팅창 틀만 만든 상태야. 다음 단계에서 실시간 메시지/소켓 연결을 붙이면 된다.
        </Typography>
      </Box>

      <Box sx={{ flex: 1, overflowY: 'auto', p: 1.5, bgcolor: 'background.default' }}>
        {messages.map((msg) => (
          <Box
            key={msg.id}
            sx={{
              display: 'flex',
              justifyContent: msg.sender === 'me' ? 'flex-end' : 'flex-start',
              mb: 1,
            }}
          >
            <Box
              sx={{
                maxWidth: '80%',
                px: 1.25,
                py: 1,
                borderRadius: 2,
                bgcolor: msg.sender === 'me' ? 'primary.main' : 'background.paper',
                color: msg.sender === 'me' ? 'primary.contrastText' : 'text.primary',
                border: msg.sender === 'me' ? 'none' : `1px solid ${theme.palette.divider}`,
                boxShadow: 1,
              }}
            >
              <Typography variant="body2">{msg.text}</Typography>
            </Box>
          </Box>
        ))}
      </Box>

      <Divider />

      <Box sx={{ p: 1.25, display: 'flex', gap: 1, alignItems: 'flex-end', bgcolor: 'background.paper' }}>
        <TextField
          fullWidth
          multiline
          minRows={2}
          maxRows={4}
          placeholder="메시지를 입력하세요"
          value={drafts[dockedChat.id] || ''}
          onChange={(e) => setDrafts((prev) => ({ ...prev, [dockedChat.id]: e.target.value }))}
          onKeyDown={(e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
              e.preventDefault();
              handleSend();
            }
          }}
        />
        <Button variant="contained" onClick={handleSend} sx={{ minWidth: 96, height: 40 }}>
          전송
        </Button>
      </Box>
    </Paper>
  );
};

export default DockedChatPanel;
