import React, { useEffect, useMemo, useState } from 'react';
import {
  Drawer,
  Box,
  Typography,
  IconButton,
  TextField,
  InputAdornment,
  List,
  ListItemButton,
  ListItemAvatar,
  ListItemText,
  Avatar,
  Chip,
  CircularProgress,
  Divider,
  Button,
  useTheme,
} from '@mui/material';
import CloseIcon from '@mui/icons-material/Close';
import SearchIcon from '@mui/icons-material/Search';
import OpenInNewIcon from '@mui/icons-material/OpenInNew';
import ChatBubbleOutlineIcon from '@mui/icons-material/ChatBubbleOutline';
import GroupIcon from '@mui/icons-material/Group';
import PersonIcon from '@mui/icons-material/Person';
import { useChat } from '../contexts/ChatContext';
import { useWindows } from '../contexts/WindowContext';
import DockedChatPanel from './DockedChatPanel';

const SIDEBAR_WIDTH = 360;
const WORKSPACE_WINDOW_ID = 'chat_workspace_main';

const formatTime = (value) => {
  if (!value) return '';
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleString('ko-KR', {
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
  });
};

const toDockedChat = (conversation) => {
  if (!conversation?.conversationId) return null;

  const isDirect = conversation.type === 'direct';
  const other = conversation.otherUser || {};

  if (isDirect) {
    return {
      conversationId: conversation.conversationId,
      conversationType: 'direct',
      userUid: other.userUid || null,
      username: other.username || other.displayName || 'unknown',
      displayName: other.displayName || other.username || '알 수 없는 사용자',
      role: other.role || 'USER',
      title: other.displayName || other.username || '알 수 없는 사용자',
      subtitle: other.displayName && other.displayName !== other.username
        ? `@${other.username}`
        : (other.role || '1:1 채팅'),
    };
  }

  const title = conversation.title || '그룹 채팅';
  const participantCount = Array.isArray(conversation.participantUids)
    ? conversation.participantUids.length
    : 0;

  return {
    conversationId: conversation.conversationId,
    conversationType: 'group',
    userUid: null,
    username: title,
    displayName: title,
    role: 'GROUP',
    title,
    subtitle: participantCount > 0 ? `참여자 ${participantCount}명` : '그룹 채팅',
  };
};

const ChatRoomSidebar = ({
  open,
  onClose,
}) => {
  const theme = useTheme();
  const { conversations, loadConversations, loadingConversations } = useChat();
  const { openWindows, setOpenWindows, topZIndex, setTopZIndex, focusWindow } = useWindows();
  const [query, setQuery] = useState('');
  const [activeRoomChat, setActiveRoomChat] = useState(null);

  useEffect(() => {
    if (!open) {
      setActiveRoomChat(null);
      return;
    }
    loadConversations();
  }, [open, loadConversations]);

  const filteredConversations = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return conversations;

    return conversations.filter((conversation) => {
      const other = conversation.otherUser || {};
      const title =
        conversation.type === 'direct'
          ? (other.displayName || other.username || '')
          : (conversation.title || '그룹 채팅');

      return [
        title,
        other.username,
        other.displayName,
        conversation.lastMessagePreview,
      ]
        .filter(Boolean)
        .some((value) => String(value).toLowerCase().includes(q));
    });
  }, [conversations, query]);

  const handleConversationClick = (conversation) => {
    const next = toDockedChat(conversation);
    if (!next) return;

    const workspace = openWindows.find(
      (w) => w.id === WORKSPACE_WINDOW_ID && w.winType === 'chat' && w.chatMode === 'workspace'
    );

    if (workspace) {
      setOpenWindows((prev) =>
        prev.map((w) =>
          w.id === WORKSPACE_WINDOW_ID
            ? {
                ...w,
                workspaceSelectedConversationId: next.conversationId,
                isMinimized: false,
              }
            : w
        )
      );
      setActiveRoomChat(null);
      focusWindow(WORKSPACE_WINDOW_ID);
      onClose?.();
      return;
    }

    setActiveRoomChat((prev) => {
      if (prev?.conversationId === next.conversationId) {
        return null;
      }
      return next;
    });
  };

  const openWorkspaceWindow = (conversationId = null) => {
    const existing = openWindows.find(
      (w) => w.id === WORKSPACE_WINDOW_ID && w.winType === 'chat' && w.chatMode === 'workspace'
    );

    if (existing) {
      setOpenWindows((prev) =>
        prev.map((w) =>
          w.id === WORKSPACE_WINDOW_ID
            ? {
                ...w,
                workspaceSelectedConversationId:
                  conversationId || w.workspaceSelectedConversationId || null,
                isMinimized: false,
              }
            : w
        )
      );
      focusWindow(WORKSPACE_WINDOW_ID);
      onClose?.();
      return;
    }

    setOpenWindows((prev) => [
      ...prev,
      {
        id: WORKSPACE_WINDOW_ID,
        name: '채팅 관리',
        winType: 'chat',
        chatMode: 'workspace',
        chatUsername: '채팅 관리',
        chatDisplayName: '채팅 관리',
        workspaceSelectedConversationId: conversationId || activeRoomChat?.conversationId || null,
        width: 1180,
        height: 760,
        x: 120 + (prev.length * 20),
        y: 72 + (prev.length * 20),
        zIndex: topZIndex + 1,
        isMinimized: false,
        isMaximized: false,
      },
    ]);
    setTopZIndex((prev) => prev + 1);
    setTimeout(() => focusWindow(WORKSPACE_WINDOW_ID), 0);
    onClose?.();
  };

  return (
    <Drawer
      anchor="right"
      open={open}
      onClose={onClose}
      sx={{ zIndex: (muiTheme) => muiTheme.zIndex.drawer + 2 }}
      PaperProps={{
        sx: {
          width: { xs: '88vw', sm: SIDEBAR_WIDTH },
          backgroundColor: 'background.paper',
          color: 'text.primary',
          overflow: 'visible',
        },
      }}
    >
      <Box sx={{ position: 'relative', height: '100%', display: 'flex', flexDirection: 'column', overflow: 'visible' }}>
        <DockedChatPanel
          sidebarWidth={SIDEBAR_WIDTH}
          activeChat={activeRoomChat}
          onOpenWindow={() => openWorkspaceWindow(activeRoomChat?.conversationId || null)}
        />

        <Box
          sx={{
            p: 2,
            display: 'flex',
            justifyContent: 'space-between',
            alignItems: 'center',
            backgroundColor: 'background.default',
            borderBottom: `1px solid ${theme.palette.divider}`,
            position: 'relative',
            zIndex: 1,
          }}
        >
          <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
            <ChatBubbleOutlineIcon fontSize="small" />
            <Typography variant="h6" sx={{ fontWeight: 800, fontSize: '1.05rem' }}>
              채팅방
            </Typography>
          </Box>

          <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
            <Button
              size="small"
              variant="outlined"
              startIcon={<OpenInNewIcon />}
              onClick={() => openWorkspaceWindow(activeRoomChat?.conversationId || null)}
            >
              window
            </Button>
            <IconButton onClick={onClose} size="small">
              <CloseIcon fontSize="small" />
            </IconButton>
          </Box>
        </Box>

        <Box sx={{ p: 2, borderBottom: `1px solid ${theme.palette.divider}`, position: 'relative', zIndex: 1 }}>
          <TextField
            fullWidth
            size="small"
            placeholder="채팅방 검색"
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            InputProps={{
              startAdornment: (
                <InputAdornment position="start">
                  <SearchIcon fontSize="small" />
                </InputAdornment>
              ),
            }}
          />
          <Typography variant="caption" color="text.secondary" sx={{ display: 'block', mt: 1 }}>
            채팅방을 누르면 이 목록의 왼쪽에 채팅방 창이 열립니다.
          </Typography>
        </Box>

        <Box sx={{ flexGrow: 1, overflowY: 'auto', p: 1.25, position: 'relative', zIndex: 1 }}>
          {loadingConversations ? (
            <Box sx={{ py: 6, display: 'flex', justifyContent: 'center' }}>
              <CircularProgress size={28} />
            </Box>
          ) : filteredConversations.length === 0 ? (
            <Typography variant="body2" sx={{ px: 1, py: 1, color: 'text.secondary' }}>
              표시할 채팅방이 없습니다.
            </Typography>
          ) : (
            <List disablePadding>
              {filteredConversations.map((conversation, idx) => {
                const other = conversation.otherUser || {};
                const isDirect = conversation.type === 'direct';
                const title = isDirect
                  ? (other.displayName || other.username || '알 수 없는 사용자')
                  : (conversation.title || '그룹 채팅');
                const subtitle = conversation.lastMessagePreview || '아직 메시지가 없습니다.';
                const unreadCount = Number(conversation.unreadCount) || 0;
                const selected = activeRoomChat?.conversationId === conversation.conversationId;

                return (
                  <React.Fragment key={conversation.conversationId}>
                    <ListItemButton
                      onClick={() => handleConversationClick(conversation)}
                      sx={{
                        borderRadius: 2,
                        mb: 0.5,
                        alignItems: 'flex-start',
                        backgroundColor: selected ? 'action.selected' : 'transparent',
                      }}
                    >
                      <ListItemAvatar>
                        <Avatar
                          sx={{
                            width: 40,
                            height: 40,
                            bgcolor: isDirect ? 'primary.main' : 'secondary.main',
                            fontWeight: 'bold',
                          }}
                        >
                          {isDirect ? (
                            (title?.[0] || 'D').toUpperCase()
                          ) : (
                            <GroupIcon sx={{ fontSize: 20 }} />
                          )}
                        </Avatar>
                      </ListItemAvatar>

                      <ListItemText
                        primary={
                          <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.75, minWidth: 0, flexWrap: 'wrap' }}>
                            <Typography variant="body2" sx={{ fontWeight: 700 }} noWrap>
                              {title}
                            </Typography>
                            <Chip
                              size="small"
                              color={isDirect ? 'primary' : 'secondary'}
                              variant="outlined"
                              icon={isDirect ? <PersonIcon /> : <GroupIcon />}
                              label={isDirect ? '1:1' : '그룹'}
                              sx={{ height: 20 }}
                            />
                            {unreadCount > 0 && (
                              <Chip
                                size="small"
                                color="error"
                                label={unreadCount > 99 ? '99+' : unreadCount}
                                sx={{ height: 20 }}
                              />
                            )}
                          </Box>
                        }
                        secondary={
                          <Box sx={{ mt: 0.5 }}>
                            <Typography
                              variant="body2"
                              color="text.secondary"
                              sx={{
                                display: 'block',
                                overflow: 'hidden',
                                textOverflow: 'ellipsis',
                                whiteSpace: 'nowrap',
                                maxWidth: 220,
                              }}
                            >
                              {subtitle}
                            </Typography>
                            <Typography variant="caption" color="text.secondary" sx={{ display: 'block', mt: 0.35 }}>
                              {formatTime(conversation.lastMessageAt || conversation.updatedAt || conversation.createdAt)}
                            </Typography>
                          </Box>
                        }
                      />
                    </ListItemButton>
                    {idx < filteredConversations.length - 1 && <Divider sx={{ my: 0.5 }} />}
                  </React.Fragment>
                );
              })}
            </List>
          )}
        </Box>
      </Box>
    </Drawer>
  );
};

export default ChatRoomSidebar;
