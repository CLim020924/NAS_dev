import React, { useEffect, useMemo, useState } from 'react';
import {
  Box,
  Paper,
  Typography,
  Avatar,
  Button,
  TextField,
  Divider,
  useTheme,
} from '@mui/material';
import OpenInNewIcon from '@mui/icons-material/OpenInNew';

const DockedChatPanel = ({ sidebarWidth = 360, activeChat = null, onOpenWindow = () => {} }) => {
  const theme = useTheme();
  const [drafts, setDrafts] = useState({});
  const [localMessages, setLocalMessages] = useState({});

  const activeKey = activeChat?.userUid || null;

  useEffect(() => {
    if (!activeChat || !activeKey) return;

    setLocalMessages((prev) => {
      if (prev[activeKey]) return prev;
      return {
        ...prev,
        [activeKey]: [
          {
            id: `${activeKey}_welcome`,
            sender: 'system',
            text: `${activeChat.displayName || activeChat.username}님과의 채팅창 틀입니다. 실시간 메시지 연결은 다음 단계에서 붙일 예정입니다.`,
            createdAt: new Date().toISOString(),
          },
        ],
      };
    });
  }, [activeChat, activeKey]);

  const messages = useMemo(() => {
    if (!activeKey) return [];
    return localMessages[activeKey] || [];
  }, [localMessages, activeKey]);

  if (!activeChat || !activeKey) return null;

  const handleSend = () => {
    const value = (drafts[activeKey] || '').trim();
    if (!value) return;

    setLocalMessages((prev) => ({
      ...prev,
      [activeKey]: [
        ...(prev[activeKey] || []),
        {
          id: `${activeKey}_${Date.now()}`,
          sender: 'me',
          text: value,
          createdAt: new Date().toISOString(),
        },
      ],
    }));

    setDrafts((prev) => ({ ...prev, [activeKey]: '' }));
  };

  return (
    <Paper
      elevation={0}
      sx={{
        position: 'absolute',
        top: 0,
        bottom: 0,
        left: 0,
        width: typeof window !== 'undefined' && window.innerWidth < 600
          ? Math.min(360, Math.round(window.innerWidth * 0.86))
          : Math.max(390, sidebarWidth + 30),
        transform: 'translateX(-100%)',
        borderRadius: 0,
        borderLeft: `1px solid ${theme.palette.divider}`,
        borderTop: `1px solid ${theme.palette.divider}`,
        borderBottom: `1px solid ${theme.palette.divider}`,
        bgcolor: 'background.paper',
        display: 'flex',
        flexDirection: 'column',
        overflow: 'hidden',
      }}
    >
      <Box
        sx={{
          px: 1.25,
          py: 1,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          bgcolor: theme.palette.mode === 'dark' ? '#111827' : '#f8fafc',
          borderBottom: `1px solid ${theme.palette.divider}`,
        }}
      >
        <Box sx={{ display: 'flex', alignItems: 'center', minWidth: 0, gap: 1 }}>
          <Button
            size="small"
            variant="outlined"
            startIcon={<OpenInNewIcon />}
            onClick={(e) => {
              e.stopPropagation();
              onOpenWindow();
            }}
          >
            window
          </Button>
          <Avatar
            sx={{
              width: 28,
              height: 28,
              bgcolor:
                activeChat.role === 'MASTER'
                  ? 'error.main'
                  : activeChat.role === 'MANAGER'
                  ? 'warning.main'
                  : 'primary.main',
              fontSize: '0.85rem',
              fontWeight: 'bold',
            }}
          >
            {(activeChat.displayName || activeChat.username)?.[0]?.toUpperCase()}
          </Avatar>
          <Box sx={{ minWidth: 0 }}>
            <Typography variant="body2" sx={{ fontWeight: 800 }} noWrap>
              {activeChat.username}
            </Typography>
            <Typography variant="caption" color="text.secondary" noWrap>
              {activeChat.displayName && activeChat.displayName !== activeChat.username
                ? activeChat.displayName
                : (activeChat.role || '채팅')}
            </Typography>
          </Box>
        </Box>
      </Box>

      <Box sx={{ px: 1.5, py: 1, bgcolor: 'background.default', borderBottom: `1px solid ${theme.palette.divider}` }}>
        <Typography variant="caption" color="text.secondary">
          사이드 채팅창입니다. window 버튼을 누르면 별도 채팅창으로 전환됩니다.
        </Typography>
      </Box>

      <Box sx={{ flex: 1, overflowY: 'auto', p: 1.5, bgcolor: 'background.default' }}>
        {messages.map((msg) => (
          <Box
            key={msg.id}
            sx={{
              display: 'flex',
              justifyContent: msg.sender === 'me' ? 'flex-end' : 'flex-start',
              mb: 1,
            }}
          >
            <Box
              sx={{
                maxWidth: '80%',
                px: 1.25,
                py: 1,
                borderRadius: 2,
                bgcolor: msg.sender === 'me' ? 'primary.main' : 'background.paper',
                color: msg.sender === 'me' ? 'primary.contrastText' : 'text.primary',
                border: msg.sender === 'me' ? 'none' : `1px solid ${theme.palette.divider}`,
                boxShadow: 1,
              }}
            >
              <Typography variant="body2">{msg.text}</Typography>
            </Box>
          </Box>
        ))}
      </Box>

      <Divider />

      <Box sx={{ p: 1.25, display: 'flex', gap: 1, alignItems: 'flex-end', bgcolor: 'background.paper' }}>
        <TextField
          fullWidth
          multiline
          minRows={2}
          maxRows={4}
          placeholder="메시지를 입력하세요"
          value={drafts[activeKey] || ''}
          onChange={(e) => setDrafts((prev) => ({ ...prev, [activeKey]: e.target.value }))}
          onKeyDown={(e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
              e.preventDefault();
              handleSend();
            }
          }}
        />
        <Button variant="contained" onClick={handleSend} sx={{ minWidth: 96, height: 40 }}>
          전송
        </Button>
      </Box>
    </Paper>
  );
};

export default DockedChatPanel;
