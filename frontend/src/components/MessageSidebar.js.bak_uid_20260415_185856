import React, { useState, useEffect } from 'react';
import { Drawer, Box, Typography, List, ListItem, ListItemAvatar, ListItemText, Avatar, Badge, TextField, InputAdornment, IconButton, Divider, useTheme } from '@mui/material';
import CloseIcon from '@mui/icons-material/Close';
import SearchIcon from '@mui/icons-material/Search';
import CircleIcon from '@mui/icons-material/Circle';
import axios from 'axios';

const MessageSidebar = ({ open, onClose }) => {
  const theme = useTheme();
  const [users, setUsers] = useState([]);
  const [searchQuery, setSearchQuery] = useState('');

  useEffect(() => {
    if (open) {
      axios.get('/api/users/data', { withCredentials: true })
        .then(res => setUsers(res.data.users || []))
        .catch(err => console.error("친구 목록 로드 실패"));
    }
  }, [open]);

  const filteredUsers = users.filter(u => u.username && u.username.toLowerCase().includes(searchQuery.toLowerCase()));

  return (
    <Drawer anchor="right" open={open} onClose={onClose} sx={{ zIndex: (theme) => theme.zIndex.drawer + 2 }} PaperProps={{ sx: { backgroundColor: 'background.paper', color: 'text.primary' } }}>
      <Box sx={{ width: { xs: '80vw', sm: 320 }, height: '100%', display: 'flex', flexDirection: 'column' }}>
        <Box sx={{ p: 2, display: 'flex', justifyContent: 'space-between', alignItems: 'center', backgroundColor: theme.palette.mode === 'dark' ? '#0f172a' : '#f8fafc', borderBottom: `1px solid ${theme.palette.divider}` }}>
          <Typography variant="h6" sx={{ fontWeight: 800, fontSize: '1.1rem' }}> 메세지 & 친구 </Typography>
          <IconButton onClick={onClose} size="small"> <CloseIcon fontSize="small" /> </IconButton>
        </Box>
        <Box sx={{ p: 2, borderBottom: `1px solid ${theme.palette.divider}` }}>
          <TextField fullWidth size="small" placeholder="아이디 검색" value={searchQuery} onChange={(e) => setSearchQuery(e.target.value)} InputProps={{ startAdornment: <InputAdornment position="start"><SearchIcon fontSize="small" /></InputAdornment> }} />
        </Box>
        <Box sx={{ flexGrow: 1, overflowY: 'auto', p: 1 }}>
          <List>
            {filteredUsers.length === 0 ? <Typography variant="body2" sx={{ textAlign: 'center', p: 2, color: 'text.secondary' }}>검색 결과가 없습니다.</Typography> : 
              filteredUsers.map((u) => (
                <ListItem key={u.id} button sx={{ borderRadius: 2, mb: 0.5 }}>
                  <ListItemAvatar>
                    <Badge overlap="circular" anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }} badgeContent={<CircleIcon sx={{ fontSize: 14, color: u.isOnline ? '#10b981' : '#94a3b8', border: `2px solid ${theme.palette.background.paper}`, borderRadius: '50%' }} />}>
                      <Avatar sx={{ width: 40, height: 40, bgcolor: u.role === 'MASTER' ? 'error.main' : (u.role === 'MANAGER' ? 'warning.main' : 'primary.main'), fontWeight: 'bold' }}>
                        {u.username[0].toUpperCase()}
                      </Avatar>
                    </Badge>
                  </ListItemAvatar>
                  <ListItemText primary={u.username} secondary={<Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}><Typography variant="caption" sx={{ color: u.role === 'MASTER' ? 'error.main' : 'text.secondary', fontWeight: 'bold' }}>{u.role}</Typography><Divider orientation="vertical" flexItem sx={{ height: 10, my: 'auto' }} /><Typography variant="caption" sx={{ color: u.isOnline ? '#10b981' : theme.palette.text.secondary }}>{u.isOnline ? '온라인' : '오프라인'}</Typography></Box>} />
                </ListItem>
              ))
            }
          </List>
        </Box>
      </Box>
    </Drawer>
  );
};
export default MessageSidebar;
