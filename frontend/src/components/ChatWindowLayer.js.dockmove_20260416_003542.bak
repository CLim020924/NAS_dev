import React, { useEffect, useMemo, useState } from 'react';
import {
  Box,
  Paper,
  Typography,
  IconButton,
  TextField,
  Button,
  Avatar,
  Chip,
  Divider,
  useTheme,
} from '@mui/material';
import { Rnd } from 'react-rnd';
import ChatBubbleOutlineIcon from '@mui/icons-material/ChatBubbleOutline';
import RemoveIcon from '@mui/icons-material/Remove';
import CropSquareIcon from '@mui/icons-material/CropSquare';
import CloseIcon from '@mui/icons-material/Close';
import SendIcon from '@mui/icons-material/Send';
import OpenInNewIcon from '@mui/icons-material/OpenInNew';
import { useWindows } from '../contexts/WindowContext';

const ChatWindowLayer = ({ messageSidebarOpen = false, onRequestCloseSidebar = () => {} }) => {
  const theme = useTheme();
  const {
    openWindows,
    setOpenWindows,
    topZIndex,
    setTopZIndex,
    focusedContext,
    focusWindow,
    closeWindow,
    toggleMinimize,
    toggleMaximize,
  } = useWindows();

  const chatWindows = useMemo(() => {
    const raw = openWindows.filter((w) => w.winType === 'chat');

    // 같은 유저/같은 id 중복 상태가 남아 있어도 마지막 것만 유효하게 본다
    const dedupedMap = new Map();
    raw.forEach((w, idx) => {
      const key = w.chatUserUid || w.id || `chat_${idx}`;
      dedupedMap.set(key, w);
    });

    const deduped = Array.from(dedupedMap.values());

    // 도킹 채팅이 있으면 같은 유저의 window 채팅은 렌더하지 않는다
    const dockedUserSet = new Set(
      deduped
        .filter((w) => w.chatMode !== 'window')
        .map((w) => w.chatUserUid || w.id)
    );

    return deduped.filter((w) => {
      const key = w.chatUserUid || w.id;
      if (w.chatMode === 'window' && dockedUserSet.has(key)) {
        return false;
      }
      return true;
    });
  }, [openWindows]);

  const [drafts, setDrafts] = useState({});
  const [localMessages, setLocalMessages] = useState({});

  useEffect(() => {
    if (chatWindows.length === 0) return;

    setLocalMessages((prev) => {
      const next = { ...prev };
      let changed = false;

      chatWindows.forEach((win) => {
        if (!next[win.id]) {
          next[win.id] = [
            {
              id: `${win.id}_welcome`,
              sender: 'system',
              text: `${win.chatDisplayName || win.name}님과의 채팅창 틀입니다. 실시간 메시지 연결은 다음 단계에서 붙일 예정입니다.`,
              createdAt: new Date().toISOString(),
            },
          ];
          changed = true;
        }
      });

      return changed ? next : prev;
    });
  }, [chatWindows]);

  if (chatWindows.length === 0) return null;

  const handleDraftChange = (id, value) => {
    setDrafts((prev) => ({ ...prev, [id]: value }));
  };

  const handleSend = (win) => {
    const value = (drafts[win.id] || '').trim();
    if (!value) return;

    setLocalMessages((prev) => ({
      ...prev,
      [win.id]: [
        ...(prev[win.id] || []),
        {
          id: `${win.id}_${Date.now()}`,
          sender: 'me',
          text: value,
          createdAt: new Date().toISOString(),
        },
      ],
    }));
    setDrafts((prev) => ({ ...prev, [win.id]: '' }));
  };

  const openAsWindow = (winId) => {
    setOpenWindows((prev) =>
      prev.map((w) =>
        w.id === winId
          ? {
              ...w,
              chatMode: 'window',
              width: w.width || 420,
              height: w.height || 560,
              x: typeof w.x === 'number' ? w.x : 120,
              y: typeof w.y === 'number' ? w.y : 90,
              zIndex: topZIndex + 1,
              isMinimized: false,
            }
          : w
      )
    );
    onRequestCloseSidebar();
    setTopZIndex((prev) => prev + 1);
    setTimeout(() => focusWindow(winId), 0);
  };

  const attachedRight = typeof window !== 'undefined' && window.innerWidth < 600
    ? Math.round(window.innerWidth * 0.88)
    : 360;

  const dockedWidth = typeof window !== 'undefined' && window.innerWidth < 600
    ? Math.min(360, Math.round(window.innerWidth * 0.86))
    : 390;

  const dockedChats = chatWindows.filter((w) => w.chatMode !== 'window');
  const dockedUserSet = new Set(dockedChats.map((w) => w.chatUserUid || w.id));
  const windowChats = chatWindows.filter((w) => w.chatMode === 'window' && !dockedUserSet.has(w.chatUserUid || w.id));

  const renderChatBody = (win) => {
    const messages = localMessages[win.id] || [];

    return (
      <>
        <Box sx={{ px: 1.5, py: 1, bgcolor: 'background.default', borderBottom: `1px solid ${theme.palette.divider}` }}>
          <Typography variant="caption" color="text.secondary">
            이 단계는 채팅창 틀만 만든 상태야. 다음 단계에서 실시간 메시지/소켓 연결을 붙이면 된다.
          </Typography>
        </Box>

        <Box sx={{ flex: 1, overflowY: 'auto', p: 1.5, bgcolor: 'background.default' }}>
          {messages.map((msg) => (
            <Box
              key={msg.id}
              sx={{
                display: 'flex',
                justifyContent: msg.sender === 'me' ? 'flex-end' : 'flex-start',
                mb: 1,
              }}
            >
              <Box
                sx={{
                  maxWidth: '80%',
                  px: 1.25,
                  py: 1,
                  borderRadius: 2,
                  bgcolor: msg.sender === 'me' ? 'primary.main' : 'background.paper',
                  color: msg.sender === 'me' ? 'primary.contrastText' : 'text.primary',
                  border: msg.sender === 'me' ? 'none' : `1px solid ${theme.palette.divider}`,
                  boxShadow: 1,
                }}
              >
                <Typography variant="body2">{msg.text}</Typography>
              </Box>
            </Box>
          ))}
        </Box>

        <Divider />

        <Box sx={{ p: 1.25, display: 'flex', gap: 1, alignItems: 'flex-end', bgcolor: 'background.paper' }}>
          <TextField
            fullWidth
            multiline
            minRows={2}
            maxRows={4}
            placeholder="메시지를 입력하세요"
            value={drafts[win.id] || ''}
            onChange={(e) => handleDraftChange(win.id, e.target.value)}
            onKeyDown={(e) => {
              if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                handleSend(win);
              }
            }}
          />
          <Button
            variant="contained"
            onClick={() => handleSend(win)}
            sx={{ minWidth: 96, height: 40 }}
            endIcon={<SendIcon />}
          >
            전송
          </Button>
        </Box>
      </>
    );
  };

  return (
    <Box
      sx={{
        position: 'fixed',
        inset: 0,
        pointerEvents: 'none',
        zIndex: 1450,
      }}
    >
      {dockedChats.map((win) => {
        const isActive = focusedContext === win.id;

        return (
          <Box
            key={win.id}
            sx={{
              display: !messageSidebarOpen || win.isMinimized ? 'none' : 'block',
              pointerEvents: 'auto',
            }}
          >
            <Paper
              elevation={isActive ? 12 : 4}
              sx={{
                position: 'fixed',
                top: 48,
                bottom: 0,
                right: `${attachedRight}px`,
                width: dockedWidth,
                display: 'flex',
                flexDirection: 'column',
                overflow: 'hidden',
                border: isActive ? `2px solid ${theme.palette.primary.main}` : `1px solid ${theme.palette.divider}`,
                borderRadius: 0,
                bgcolor: 'background.paper',
              }}
              onMouseDown={() => focusWindow(win.id)}
            >
              <Box
                sx={{
                  px: 1.25,
                  py: 1,
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  bgcolor: theme.palette.mode === 'dark' ? '#111827' : '#f8fafc',
                  borderBottom: `1px solid ${theme.palette.divider}`,
                }}
              >
                <Box sx={{ display: 'flex', alignItems: 'center', minWidth: 0, gap: 1 }}>
                  <Button
                    size="small"
                    variant="outlined"
                    startIcon={<OpenInNewIcon />}
                    onClick={(e) => {
                      e.stopPropagation();
                      openAsWindow(win.id);
                    }}
                  >
                    window
                  </Button>
                  <Avatar
                    sx={{
                      width: 28,
                      height: 28,
                      bgcolor:
                        win.chatRole === 'MASTER'
                          ? 'error.main'
                          : win.chatRole === 'MANAGER'
                          ? 'warning.main'
                          : 'primary.main',
                      fontSize: '0.85rem',
                      fontWeight: 'bold',
                    }}
                  >
                    {(win.chatDisplayName || win.name)?.[0]?.toUpperCase()}
                  </Avatar>
                  <Box sx={{ minWidth: 0 }}>
                    <Typography variant="body2" sx={{ fontWeight: 800 }} noWrap>
                      {win.chatDisplayName || win.name}
                    </Typography>
                    <Typography variant="caption" color="text.secondary" noWrap>
                      @{win.chatUsername || win.name}
                    </Typography>
                  </Box>
                </Box>

                <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.25 }} />
              </Box>

              {renderChatBody(win)}
            </Paper>
          </Box>
        );
      })}

      {windowChats.map((win) => {
        const isActive = focusedContext === win.id;
        const fillsParent = !!win.isMaximized;

        return (
          <Box
            key={win.id}
            sx={{
              display: messageSidebarOpen || win.isMinimized ? 'none' : 'block',
              pointerEvents: 'auto',
            }}
          >
            <Rnd
              size={fillsParent ? { width: '100vw', height: 'calc(100vh - 48px)' } : { width: win.width, height: win.height }}
              position={fillsParent ? { x: 0, y: 48 } : { x: win.x, y: win.y }}
              onMouseDown={() => focusWindow(win.id)}
              dragHandleClassName="chat-window-header"
              bounds="window"
              disableDragging={fillsParent}
              enableResizing={!fillsParent}
              onDragStop={(e, d) => {
                setOpenWindows((prev) =>
                  prev.map((w) => (w.id === win.id ? { ...w, x: d.x, y: d.y } : w))
                );
              }}
              onResizeStop={(e, direction, ref, delta, position) => {
                setOpenWindows((prev) =>
                  prev.map((w) =>
                    w.id === win.id
                      ? {
                          ...w,
                          width: ref.style.width,
                          height: ref.style.height,
                          x: position.x,
                          y: position.y,
                        }
                      : w
                  )
                );
              }}
              style={{ zIndex: fillsParent ? 99999 : win.zIndex }}
            >
              <Paper
                elevation={isActive ? 12 : 4}
                sx={{
                  display: 'flex',
                  flexDirection: 'column',
                  height: '100%',
                  overflow: 'hidden',
                  border: isActive ? `2px solid ${theme.palette.primary.main}` : `1px solid ${theme.palette.divider}`,
                  borderRadius: fillsParent ? 0 : 2,
                  bgcolor: 'background.paper',
                }}
              >
                <Box
                  className="chat-window-header"
                  sx={{
                    px: 1.25,
                    py: 1,
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'space-between',
                    bgcolor: theme.palette.mode === 'dark' ? '#111827' : '#f8fafc',
                    borderBottom: `1px solid ${theme.palette.divider}`,
                    cursor: fillsParent ? 'default' : 'move',
                  }}
                >
                  <Box sx={{ display: 'flex', alignItems: 'center', minWidth: 0, gap: 1 }}>
                    <Avatar
                      sx={{
                        width: 28,
                        height: 28,
                        bgcolor:
                          win.chatRole === 'MASTER'
                            ? 'error.main'
                            : win.chatRole === 'MANAGER'
                            ? 'warning.main'
                            : 'primary.main',
                        fontSize: '0.85rem',
                        fontWeight: 'bold',
                      }}
                    >
                      {(win.chatDisplayName || win.name)?.[0]?.toUpperCase()}
                    </Avatar>
                    <Box sx={{ minWidth: 0 }}>
                      <Typography variant="body2" sx={{ fontWeight: 800 }} noWrap>
                        {win.chatDisplayName || win.name}
                      </Typography>
                      <Typography variant="caption" color="text.secondary" noWrap>
                        @{win.chatUsername || win.name}
                      </Typography>
                    </Box>
                    <Chip size="small" icon={<ChatBubbleOutlineIcon />} label="window" variant="outlined" />
                  </Box>

                  <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.25 }}>
                    <IconButton size="small" onClick={(e) => { e.stopPropagation(); toggleMinimize(win.id); }} title="최소화">
                      <RemoveIcon fontSize="small" />
                    </IconButton>
                    <IconButton size="small" onClick={(e) => { e.stopPropagation(); toggleMaximize(win.id); }} title="최대화">
                      <CropSquareIcon fontSize="small" />
                    </IconButton>
                    <IconButton size="small" color="error" onClick={(e) => { e.stopPropagation(); closeWindow(win.id); }} title="닫기">
                      <CloseIcon fontSize="small" />
                    </IconButton>
                  </Box>
                </Box>

                {renderChatBody(win)}
              </Paper>
            </Rnd>
          </Box>
        );
      })}
    </Box>
  );
};

export default ChatWindowLayer;
