import React from 'react';
import { Box, Paper, Typography, IconButton } from '@mui/material';
import { Rnd } from 'react-rnd';
import MenuIcon from '@mui/icons-material/Menu';
import RemoveIcon from '@mui/icons-material/Remove';
import CropSquareIcon from '@mui/icons-material/CropSquare';
import FilterNoneIcon from '@mui/icons-material/FilterNone';
import CloseIcon from '@mui/icons-material/Close';
import SidebarTree from './SidebarTree';
import FolderView from './FolderView';
import ChatView from './ChatView';

const NASWindow = ({
  win,
  theme,
  isMobile,
  fetchFiles,
  closeWindow,
  toggleSidebar,
  focusWindow,
  focusedContext,
  toggleMinimize,
  toggleMaximize,
  toggleFullscreen
}) => {
  const isActive = focusedContext === win.id;
  const fillsParent = !!win.isMaximized || !!win.isImmersive;
  const isChat = win.winType === 'chat';

  const rndSize = fillsParent
    ? { width: '100%', height: '100%' }
    : { width: win.width, height: win.height };

  const rndPosition = fillsParent
    ? { x: 0, y: 0 }
    : { x: win.x, y: win.y };

  const titleText = isChat
    ? (win.chatUsername || win.name || 'chat')
    : (win.currentPath || win.name || '/');

  return (
    <Rnd
      size={rndSize}
      position={rndPosition}
      onMouseDown={() => focusWindow(win.id)}
      dragHandleClassName="window-header"
      bounds="parent"
      disableDragging={fillsParent}
      enableResizing={!fillsParent}
    >
      <Paper
        elevation={isActive ? 10 : 2}
        sx={{
          display: 'flex',
          flexDirection: 'column',
          height: '100%',
          overflow: 'hidden',
          border: isActive ? `2px solid ${theme.palette.primary.main}` : `1px solid ${theme.palette.divider}`,
          borderRadius: win.isImmersive ? 0 : 2,
          bgcolor: 'background.paper'
        }}
      >
        <Box
          className="window-header"
          sx={{
            p: 1,
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            bgcolor: theme.palette.mode === 'dark' ? '#111827' : '#f8fafc',
            borderBottom: `1px solid ${theme.palette.divider}`,
            cursor: fillsParent ? 'default' : 'move'
          }}
        >
          <Box sx={{ display: 'flex', alignItems: 'center', minWidth: 0 }}>
            {!isChat && (
              <IconButton size="small" onClick={(e) => { e.stopPropagation(); toggleSidebar(win.id); }}>
                <MenuIcon fontSize="small" />
              </IconButton>
            )}
            <Typography
              variant="body2"
              sx={{ ml: isChat ? 0 : 1, fontWeight: 800, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}
            >
              {titleText}
            </Typography>
          </Box>

          <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.25 }}>
            <IconButton size="small" onClick={(e) => { e.stopPropagation(); toggleMinimize(win.id); }} title="최소화">
              <RemoveIcon fontSize="small" />
            </IconButton>
            <IconButton size="small" onClick={(e) => { e.stopPropagation(); toggleMaximize(win.id); }} title="최대화">
              <CropSquareIcon fontSize="small" />
            </IconButton>
            <IconButton size="small" onClick={(e) => { e.stopPropagation(); toggleFullscreen(win.id); }} title="풀스크린">
              <FilterNoneIcon fontSize="small" />
            </IconButton>
            <IconButton size="small" onClick={(e) => { e.stopPropagation(); closeWindow(win.id); }} color="error" title="닫기">
              <CloseIcon fontSize="small" />
            </IconButton>
          </Box>
        </Box>

        <Box sx={{ display: 'flex', flex: 1, overflow: 'hidden' }}>
          {isChat ? (
            <Box sx={{ flex: 1, overflow: 'hidden', bgcolor: 'background.default' }}>
              <ChatView win={win} />
            </Box>
          ) : (
            <>
              {win.sidebarOpen !== false && (
                <Box sx={{ width: 220, borderRight: `1px solid ${theme.palette.divider}`, display: 'flex', flexDirection: 'column', bgcolor: 'background.paper' }}>
                  <SidebarTree win={win} fetchFiles={fetchFiles} />
                </Box>
              )}
              <Box sx={{ flex: 1, overflow: 'auto', bgcolor: 'background.default' }}>
                <FolderView win={win} fetchFiles={fetchFiles} theme={theme} isMobile={isMobile} />
              </Box>
            </>
          )}
        </Box>
      </Paper>
    </Rnd>
  );
};

export default NASWindow;
