import { useCallback, useEffect, useMemo, useState } from 'react';
import {
  getUnreadNotificationCount,
  listNotifications,
  readAllNotifications,
  readNotificationGroup,
} from './notificationApi';
import {
  getNotificationBadgeCount,
  groupNotificationsForDisplay,
  markAllNotificationsAsReadLocal,
  markNotificationGroupAsReadLocal,
} from './notificationSelectors';

const useNotifications = ({
  user,
  open = false,
  socket = null,
  onNavigateFromNotification = () => {},
}) => {
  const [loading, setLoading] = useState(false);
  const [notifications, setNotifications] = useState([]);
  const [unreadCount, setUnreadCount] = useState(0);

  const syncNotifications = useCallback((items) => {
    const safeItems = Array.isArray(items) ? items : [];
    setNotifications(safeItems);
    setUnreadCount(getNotificationBadgeCount(safeItems));
  }, []);

  const refreshUnreadCount = useCallback(async () => {
    if (!user) {
      setUnreadCount(0);
      return;
    }

    try {
      const nextUnreadCount = await getUnreadNotificationCount();
      setUnreadCount(nextUnreadCount);
    } catch (err) {
      console.error('읽지 않은 알림 개수 로드 실패', err);
    }
  }, [user]);

  const refreshNotifications = useCallback(async ({ silent = false } = {}) => {
    if (!user) {
      syncNotifications([]);
      return;
    }

    try {
      if (!silent) setLoading(true);
      const items = await listNotifications();
      syncNotifications(items);
    } catch (err) {
      console.error('알림 목록 로드 실패', err);
    } finally {
      if (!silent) setLoading(false);
    }
  }, [user, syncNotifications]);

  useEffect(() => {
    refreshUnreadCount();
    if (!user) return undefined;

    const interval = setInterval(() => {
      refreshUnreadCount();
    }, 10000);

    return () => clearInterval(interval);
  }, [user, refreshUnreadCount]);

  useEffect(() => {
    if (!open) return undefined;
    refreshNotifications();
    const interval = setInterval(() => {
      refreshNotifications({ silent: true });
    }, 10000);
    return () => clearInterval(interval);
  }, [open, refreshNotifications]);

  useEffect(() => {
    if (!socket || !user) return undefined;

    const handleIncomingChatMessage = () => {
      refreshUnreadCount();
      if (open) {
        refreshNotifications({ silent: true });
      }
    };

    socket.on('chat:message', handleIncomingChatMessage);

    return () => {
      socket.off('chat:message', handleIncomingChatMessage);
    };
  }, [socket, user, open, refreshUnreadCount, refreshNotifications]);

  const handleNotificationClick = useCallback(async (notification) => {
    const prev = notifications;
    const next = markNotificationGroupAsReadLocal(notifications, notification);

    try {
      syncNotifications(next);

      if (notification && !notification.isRead) {
        await readNotificationGroup({
          notificationId: notification.notificationId,
          conversationId: String(notification?.meta?.conversationId || ''),
          fromUserUid: String(notification?.meta?.fromUserUid || ''),
        });
      }

      onNavigateFromNotification(notification);
    } catch (err) {
      syncNotifications(prev);
      alert(err.response?.data?.error || '알림 처리에 실패했습니다.');
    }
  }, [notifications, syncNotifications, onNavigateFromNotification]);

  const handleReadAll = useCallback(async () => {
    const prev = notifications;
    const next = markAllNotificationsAsReadLocal(notifications);

    try {
      syncNotifications(next);
      await readAllNotifications();
    } catch (err) {
      syncNotifications(prev);
      alert(err.response?.data?.error || '전체 읽음 처리에 실패했습니다.');
    }
  }, [notifications, syncNotifications]);

  const visibleNotifications = useMemo(
    () => groupNotificationsForDisplay(notifications),
    [notifications]
  );

  return {
    loading,
    notifications,
    visibleNotifications,
    unreadCount,
    refreshUnreadCount,
    refreshNotifications,
    handleNotificationClick,
    readAllNotifications: handleReadAll,
  };
};

export default useNotifications;
